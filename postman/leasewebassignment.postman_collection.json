{
  "info": {
    "name": "Leaseweb Assignment API",
    "description": "Collection for the Leaseweb Assignment server API (v1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Get Servers (filtered, first page)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/servers?model=Dell&ram=16GB&ram=32GB&disk_type=SATA&location=Amsterdam&storage_min=500GB&storage_max=2TB&limit=50&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "servers"
          ],
          "query": [
            { "key": "model", "value": "Dell" },
            { "key": "ram", "value": "16GB", "description": "repeat this param for multi-select, e.g. ram=16GB&ram=32GB" },
            { "key": "ram", "value": "32GB" },
            { "key": "disk_type", "value": "SATA" },
            { "key": "location", "value": "Amsterdam" },
            { "key": "storage_min", "value": "500GB" },
            { "key": "storage_max", "value": "2TB" },
            { "key": "limit", "value": "50" },
            { "key": "offset", "value": "0" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Servers (no filters)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/servers",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "servers"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Upload Servers CSV",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/v1/admin/upload",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "admin",
            "upload"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "healthz"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Readiness check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/readyz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "readyz"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_token",
      "value": "your-admin-token"
    }
  ]
}
